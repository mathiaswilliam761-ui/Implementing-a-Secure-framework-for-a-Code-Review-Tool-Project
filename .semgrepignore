# .semgrepignore
# Ignore patterns for Semgrep to skip during scans

# Python virtual environment
.venv/
**/.venv/**

# Node.js dependencies
node_modules/
**/node_modules/**

# Reports and outputs
reports/
**/reports/**

# Deliverables
deliverables/
**/deliverables/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test files (optional - uncomment to skip tests)
# test_*.py
# *_test.py
# tests/
# spec/

# Temporary files
tmp/
temp/
*.tmp

# Git
.git/