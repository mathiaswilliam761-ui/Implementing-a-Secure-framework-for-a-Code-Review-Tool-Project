{
  "name": "vulnerable-node-app",
  "version": "1.0.0",
  "description": "Intentionally vulnerable Node.js application for SAST/SCA testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "keywords": [
    "vulnerable",
    "security",
    "testing",
    "sast",
    "sca"
  ],
  "author": "Security Testing Framework",
  "license": "MIT",
  "dependencies": {
    "express": "4.16.0",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.15",
    "moment": "2.24.0",
    "request": "2.88.0",
    "serialize-javascript": "2.1.1",
    "validator": "12.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.0",
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^4.2.0"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "vulnerabilities": {
    "express": {
      "version": "4.16.0",
      "cves": [
        "CVE-2022-24999",
        "CVE-2020-8174",
        "CVE-2020-15166"
      ],
      "description": "Multiple vulnerabilities in Express.js < 4.17.3"
    },
    "lodash": {
      "version": "4.17.15",
      "cves": [
        "CVE-2021-23337",
        "CVE-2020-28500",
        "CVE-2019-10744"
      ],
      "description": "Prototype pollution and command injection in Lodash < 4.17.21"
    },
    "jsonwebtoken": {
      "version": "8.5.1",
      "cves": [
        "CVE-2022-23529",
        "CVE-2020-28054"
      ],
      "description": "Algorithm confusion and signature validation bypass"
    },
    "moment": {
      "version": "2.24.0",
      "cves": [
        "CVE-2022-24785",
        "CVE-2022-23060"
      ],
      "description": "ReDoS and path traversal in Moment.js < 2.29.2"
    },
    "request": {
      "version": "2.88.0",
      "cves": [
        "CVE-2020-26293",
        "CVE-2019-15501"
      ],
      "description": "Deprecated package with multiple vulnerabilities"
    },
    "serialize-javascript": {
      "version": "2.1.1",
      "cves": [
        "CVE-2020-7660",
        "CVE-2019-16769"
      ],
      "description": "XSS via prototype pollution in serialize-javascript < 3.1.0"
    },
    "validator": {
      "version": "12.0.0",
      "cves": [
        "CVE-2020-7792",
        "CVE-2020-7755"
      ],
      "description": "ReDoS in validator < 13.1.1"
    }
  }
}
