# .gitleaksignore
# Ignore false positives and known test secrets in reports/documentation

# Ignore all reports (contain detected secrets for documentation)
reports/

# Ignore deliverables (contain vulnerable code examples for training)
deliverables/

# Ignore vulnerable samples (intentional test vulnerabilities)
vulnerable-samples/

# Ignore scanner rule files (contain example secrets in remediation examples)
scanners/semgrep-rules/

# Ignore node_modules
node_modules/

# Ignore .venv
.venv/

# Ignore PROJECT_DOCUMENTATION.md (contains sanitized examples)
PROJECT_DOCUMENTATION.md

# Ignore sanitized test placeholders in test files
# Path-based exclusions for test files with sanitized keys
vulnerable-samples/python-app/app.py
vulnerable-samples/node-app/server.js
scanners/semgrep-rules/custom-security-rules.yaml